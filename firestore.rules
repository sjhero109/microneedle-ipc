rules_version = '2';

// 마이크로니들 IPC 보안 규칙
// - 로그인하고 users 문서가 있으며 active 이고, 로그인 실패로 잠기지 않은 사람만 읽고 쓸 수 있다
// - 모든 데이터 쓰기는 같은 batch 안에 본인 이름의 auditLog 문서가 있어야 한다
// - 삭제는 어디에서도 허용하지 않는다
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    // users 문서가 없으면 읽기 오류가 나고, 그 규칙은 거부된다
    function profile() {
      return get(userPath()).data;
    }
    function guardPath() {
      return /databases/$(database)/documents/loginGuard/$(request.auth.token.email);
    }
    // 로그인 실패가 쌓여 잠긴 계정은 비밀번호가 맞아도 아무것도 할 수 없다
    function unlocked() {
      return !exists(guardPath()) || get(guardPath()).data.locked != true;
    }
    function active() {
      return signedIn() && profile().active == true && unlocked();
    }
    function admin() {
      let u = profile();
      return signedIn() && u.active == true && u.role == 'admin' && unlocked();
    }
    function auditPath(id) {
      return /databases/$(database)/documents/auditLog/$(id);
    }
    // 이 쓰기와 함께, 본인이 새로 만드는 audit 기록이 같은 batch 에 들어 있어야 한다
    function audited() {
      let id = request.resource.data.auditId;
      return id is string
        && !exists(auditPath(id))
        && existsAfter(auditPath(id))
        && getAfter(auditPath(id)).data.uid == request.auth.uid;
    }
    function setupPath() {
      return /databases/$(database)/documents/meta/setup;
    }
    // 본인이 직접 가입한다. 맨 처음 가입한 사람만 관리자가 되고, 그 뒤로는 승인 대기 상태로만 만들 수 있다
    function selfSignup(uid) {
      let d = request.resource.data;
      let first = !exists(setupPath()) && existsAfter(setupPath());
      return signedIn() && uid == request.auth.uid
        && d.uid == uid
        && d.email == request.auth.token.email
        && d.name is string
        && d.createdAt == request.time
        && ((d.role == 'user' && d.active == false && d.pending == true)
            || (d.role == 'admin' && d.active == true && first));
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    // 로그인한 사람이 남기는 audit 기록: 이름·권한·시각을 속일 수 없다
    function ownAudit() {
      let u = profile();
      let d = request.resource.data;
      return signedIn() && u.active == true && unlocked()
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.name == u.name
        && d.role == u.role
        && d.at == request.time
        && d.action is string;
    }
    // 로그인 전에 남기는 audit 기록: 로그인 실패, 계정 잠금, 잠긴 관리자에게 보낸 재설정 메일뿐이다
    function loginFailureAudit() {
      let d = request.resource.data;
      return request.auth == null
        && d.keys().hasOnly(['uid', 'name', 'email', 'role', 'action', 'target', 'targetId', 'at', 'after'])
        && d.uid == ''
        && d.name == ''
        && d.role == 'none'
        && d.email is string && d.email.size() < 200
        && d.action in ['로그인 실패', '계정 잠금', '재설정 메일 발송']
        && d.at == request.time;
    }

    match /auditLog/{id} {
      allow read: if admin() || (active() && resource.data.uid == request.auth.uid);
      allow create: if loginFailureAudit() || ownAudit();
      allow update, delete: if false;
    }

    // 이메일별 로그인 실패 횟수. 5회가 되면 잠기고, 관리자만 풀 수 있다
    match /loginGuard/{email} {
      allow get: if true;
      allow list: if admin();
      // 실패 1회 기록 (로그인 전이므로 누구나 쓸 수 있지만 1씩만 늘릴 수 있다)
      allow create: if request.resource.data.keys().hasOnly(['email', 'fails', 'locked', 'updatedAt'])
        && email.size() < 200
        && request.resource.data.email == email
        && request.resource.data.fails == 1
        && request.resource.data.locked == false
        && request.resource.data.updatedAt == request.time;
      allow update: if
        // 실패 1회 추가. 5회째에 잠긴다
        (request.resource.data.keys().hasOnly(['email', 'fails', 'locked', 'updatedAt', 'auditId'])
          && resource.data.locked != true
          && request.resource.data.email == email
          && request.resource.data.fails == resource.data.fails + 1
          && request.resource.data.locked == (request.resource.data.fails >= 5)
          && request.resource.data.updatedAt == request.time)
        // 로그인에 성공하면 본인이 횟수를 0으로 되돌린다 (잠긴 뒤에는 불가)
        || (signedIn()
          && request.auth.token.email == email
          && resource.data.locked != true
          && request.resource.data.fails == 0
          && request.resource.data.locked == false
          && request.resource.data.updatedAt == request.time)
        // 잠긴 관리자는 메일로 비밀번호를 다시 정한 뒤 스스로 푼다 (풀어 줄 다른 관리자가 없을 수 있다)
        || (signedIn()
          && request.auth.token.email == email
          && profile().active == true
          && profile().role == 'admin'
          && request.resource.data.fails == 0
          && request.resource.data.locked == false
          && request.resource.data.updatedAt == request.time)
        // 관리자가 잠금을 푼다
        || (admin() && audited()
          && request.resource.data.fails == 0
          && request.resource.data.locked == false
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if selfSignup(uid);
      // 관리자가 자기 권한을 스스로 없애 아무도 관리할 수 없게 되는 일을 막는다
      allow create, update: if admin() && audited()
        && request.resource.data.role in ['user', 'admin']
        && request.resource.data.active is bool
        && !(uid == request.auth.uid
             && (request.resource.data.role != 'admin' || request.resource.data.active != true));
      // 초기화된 비밀번호를 본인이 바꾼 뒤 "변경 필요" 표시를 지운다
      allow update: if signedIn() && uid == request.auth.uid
        && onlyChanges(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
      allow delete: if false;
    }

    // 로그인 키. 관리자가 비밀번호를 초기화할 때만 읽는다. 본인도 읽을 수 없다
    match /secrets/{uid} {
      allow get: if admin();
      allow create, update: if signedIn() && (request.auth.uid == uid || admin())
        && request.resource.data.keys().hasOnly(['key', 'updatedAt'])
        && request.resource.data.key is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 최초 관리자 등록이 끝났다는 표시. 한 번 만들어지면 바꾸거나 지울 수 없다
    match /meta/setup {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath()).data.role == 'admin';
      allow update, delete: if false;
    }

    // 관리자 이메일의 해시 목록. 로그인 화면이 "잠긴 계정이 관리자인지" 알아보는 데만 쓴다
    match /meta/admins {
      allow get: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['hashes', 'updatedAt'])
        && request.resource.data.hashes is list
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /recipes/{id} {
      allow read: if active();
      allow create, update: if admin() && audited() && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /batches/{id} {
      allow read: if active();
      allow create: if active() && audited()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // 완료된 배치는 다시 여는 것만 할 수 있다 (작업자도 가능). 연 뒤에야 내용을 고칠 수 있다
      allow update: if active() && audited()
        && onlyChanges(['drugName', 'baseName', 'shots', 'mfgDate', 'status', 'closedAt', 'closedBy', 'closedByName', 'auditId'])
        && (resource.data.get('status', 'open') != 'closed' || request.resource.data.status == 'open');
      allow delete: if false;
    }

    match /records/{id} {
      allow read: if active();
      allow create: if active() && audited()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.excluded == false
        && (request.resource.data.source == 'manual' || admin())
        // 완료된 배치에는 더 기록할 수 없다
        && get(/databases/$(database)/documents/batches/$(request.resource.data.batchId)).data.get('status', 'open') != 'closed';
      // 기록 수정은 관리자의 정정 승인, 이상치 제외, 테스트 기록의 계산 편입뿐이다
      allow update: if admin() && audited()
        && onlyChanges(['tray', 'pulse', 'totalWeight', 'weight', 'devPct', 'band', 'pass',
                        'excluded', 'excludeReason', 'test', 'auditId']);
      allow delete: if false;
    }

    match /corrections/{id} {
      allow read: if active();
      allow create: if active() && audited()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'pending';
      allow update: if admin() && audited()
        && resource.data.status == 'pending'
        && request.resource.data.reviewedBy == request.auth.uid
        && onlyChanges(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote', 'auditId']);
      allow delete: if false;
    }
  }
}
